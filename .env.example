# Copy this file to .env and fill it in. .env is git-ignored: never commit real values.

# --- Public address (docker compose / Caddy) ---------------------------------
# The host name that points at your server. Caddy gets a certificate for it.
# It is a Cloudflare DNS record in lalutir.com that must be "DNS only" (grey
# cloud), not proxied: see docs/DEPLOYMENT.md, section 6.
DOMAIN=fiesta-reserveringen.lalutir.com

# --- App ---------------------------------------------------------------------
# Household time zone (IANA name). Times are stored in UTC and shown in this zone.
HOUSEHOLD_TZ=Europe/Amsterdam

# First admin. Only used while there are no users at all. Fill in ADMIN_PASSWORD
# with a long random password (for example: openssl rand -base64 24), start the
# app once, log in, then DELETE the ADMIN_PASSWORD line. It is empty on purpose:
# with no password set no admin is created, so a copied example file can never
# leave an account with a publicly known password.
# Use only letters, digits and - _ . / + = in it: docker compose treats $ and #
# specially in .env files.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# How many nightly database backups to keep.
BACKUP_KEEP_DAYS=14

# --- Reminders (Web Push) ----------------------------------------------------
# The app can send a phone notification before a reservation starts and when it
# ends, to remind you of the kilometre registration. It needs no extra setup:
# it identifies itself to the push services (Google, Apple, Mozilla) with
# https://<DOMAIN> above. Everyone still taps "Enable" once per device on the
# Account page. See docs/DEPLOYMENT.md, section 18.
# true = on (default), false = switch all reminders off.
PUSH_ENABLED=true
# Optional: use this contact instead of https://<DOMAIN> (an https:// URL or a
# mailto: address). It is sent to the push services with every notification.
# PUSH_CONTACT=

# --- Payment requests for fuel (optional, UNVERIFIED) -------------------------
# By default the app writes the payment request as text that you send yourself
# (share, SMS, WhatsApp). The Tikkie adapter below only switches on when ALL
# THREE are filled in. Tikkie's API is offered to Tikkie business customers; a
# private household most likely has no access, so this stays empty. It was only
# tried against a test stub. See docs/DEPLOYMENT.md, section 18.
TIKKIE_PAYMENT_REQUEST_URL=
TIKKIE_API_KEY=
TIKKIE_ACCESS_TOKEN=

# --- Optional tuning ---------------------------------------------------------
# scrypt cost (defaults shown). If a login takes much more than 0.5 s on your
# server, lower SCRYPT_P to 1 or 2. Existing passwords keep working.
# SCRYPT_N=32768
# SCRYPT_R=8
# SCRYPT_P=3

# --- Local development only --------------------------------------------------
# Plain http on localhost cannot use Secure cookies. NEVER set this in production.
# COOKIE_SECURE=false
# PORT=3000
