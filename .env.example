# Copy this file to .env and fill it in. .env is git-ignored: never commit real values.

# --- Public address (docker compose / Caddy) ---------------------------------
# The host name that points at your server. Caddy gets a certificate for it.
DOMAIN=car.example.com

# --- App ---------------------------------------------------------------------
# Household time zone (IANA name). Times are stored in UTC and shown in this zone.
HOUSEHOLD_TZ=Europe/Amsterdam

# First admin. Only used while there are no users at all. Fill in ADMIN_PASSWORD
# with a long random password (for example: openssl rand -base64 24), start the
# app once, log in, then DELETE the ADMIN_PASSWORD line. It is empty on purpose:
# with no password set no admin is created, so a copied example file can never
# leave an account with a publicly known password.
# Use only letters, digits and - _ . / + = in it: docker compose treats $ and #
# specially in .env files.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# How many nightly database backups to keep.
BACKUP_KEEP_DAYS=14

# --- Optional tuning ---------------------------------------------------------
# scrypt cost (defaults shown). If a login takes much more than 0.5 s on your
# server, lower SCRYPT_P to 1 or 2. Existing passwords keep working.
# SCRYPT_N=32768
# SCRYPT_R=8
# SCRYPT_P=3

# --- Local development only --------------------------------------------------
# Plain http on localhost cannot use Secure cookies. NEVER set this in production.
# COOKIE_SECURE=false
# PORT=3000
