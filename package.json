{
  "name": "fiesta-reservering-en-kilometer-registratie",
  "version": "1.0.0",
  "description": "Private reservation and usage log for one shared car (PWA + admin page)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint .",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "cli": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/cli.ts",
    "icons": "node scripts/make-icons.mjs",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "npm run build && playwright test --config e2e/playwright.config.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2"
  }
}
