{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowJs": true,
    "checkJs": true,
    "types": [],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["public", "shared"],
  "exclude": ["public/sw.js"]
}
